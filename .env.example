# Lead capture → forward to GoHighLevel / n8n webhook (optional; no-op if unset)
LEAD_WEBHOOK_URL=

# Google Maps Static API key — SERVER-SIDE ONLY (reached via /api/staticmap proxy, never exposed).
GOOGLE_MAPS_API_KEY=
# Public flag (no secret) telling the client the maps proxy is available. Set to "true" when the key is set.
NEXT_PUBLIC_MAPS_ENABLED=
